model Client {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String       @map("dietitian_account_id") @db.Uuid
  code               String?
  firstName          String       @map("first_name")
  lastName           String       @map("last_name")
  displayName        String?      @map("display_name")
  email              String?
  phone              String?
  dateOfBirth        DateTime?    @map("date_of_birth") @db.Date
  sex                ClientSex?
  status             ClientStatus @default(ACTIVE)
  createdById        String?      @map("created_by_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz

  dietitianAccount DietitianAccount    @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)
  createdBy        User?               @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  account          ClientAccount?
  profile          ClientProfile?
  assignments      ClientAssignment[]
  goals            ClientGoal[]
  tags             ClientTag[]
  measurements     ClientMeasurement[]
  timeline         TimelineEvent[]
  assessments      Assessment[]
  appointments     Appointment[]
  invitations      InvitationToken[]
  mealPlans        MealPlan[]
  foodLogs               FoodLog[]
  waterLogs              WaterLog[]
  exerciseLogs           ExerciseLog[]
  sleepLogs              SleepLog[]
  habitLogs              HabitLog[]
  clientHabitAssignments ClientHabitAssignment[]
  conversation           Conversation?
  documents        Document[]
  invoices         Invoice[]
  tasks            Task[]
  aiRequests       AiRequest[]
  activeSessions   Session[]

  @@unique([dietitianAccountId, code])
  @@index([dietitianAccountId, status])
  @@index([dietitianAccountId, lastName])
  @@map("clients")
}

model ClientAccount {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  clientId           String              @unique @map("client_id") @db.Uuid
  dietitianAccountId String              @map("dietitian_account_id") @db.Uuid
  status             ClientAccountStatus @default(PENDING)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  activatedAt        DateTime?           @map("activated_at") @db.Timestamptz
  deactivatedAt      DateTime?           @map("deactivated_at") @db.Timestamptz

  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)

  @@unique([userId, dietitianAccountId])
  @@index([userId])
  @@index([dietitianAccountId])
  @@map("client_accounts")
}

model ClientAssignment {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String    @map("dietitian_account_id") @db.Uuid
  clientId           String    @map("client_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  assignedById       String?   @map("assigned_by_id") @db.Uuid
  assignedAt         DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  unassignedAt       DateTime? @map("unassigned_at") @db.Timestamptz

  client           Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user             User             @relation("ClientAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy       User?            @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)

  @@index([dietitianAccountId, clientId])
  @@index([userId, unassignedAt])
  @@index([clientId, unassignedAt])
  @@map("client_assignments")
}

model ClientProfile {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId    String   @map("dietitian_account_id") @db.Uuid
  clientId              String   @unique @map("client_id") @db.Uuid
  nutritionContext      String?  @map("nutrition_context") @db.Text
  preferences           String?  @db.Text
  dietaryPreferences    String?  @map("dietary_preferences") @db.Text
  allergies             String?  @db.Text
  intolerances          String?  @db.Text
  lifestyle             String?  @db.Text
  notes                 String?  @db.Text
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)

  @@index([dietitianAccountId])
  @@map("client_profiles")
}

model ClientGoal {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String     @map("dietitian_account_id") @db.Uuid
  clientId           String     @map("client_id") @db.Uuid
  title              String
  description        String?    @db.Text
  status             GoalStatus @default(ACTIVE)
  targetValue        Decimal?   @map("target_value") @db.Decimal(12, 3)
  targetUnit         String?    @map("target_unit")
  startDate          DateTime?  @map("start_date") @db.Date
  targetDate         DateTime?  @map("target_date") @db.Date
  completedAt        DateTime?  @map("completed_at") @db.Timestamptz
  createdById        String?    @map("created_by_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  client           Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy        User?            @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)

  @@index([dietitianAccountId, clientId])
  @@index([clientId, status])
  @@map("client_goals")
}

model Tag {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String   @map("dietitian_account_id") @db.Uuid
  name               String
  color              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Cascade)
  clients          ClientTag[]

  @@unique([dietitianAccountId, name])
  @@map("tags")
}

model ClientTag {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String   @map("dietitian_account_id") @db.Uuid
  clientId           String   @map("client_id") @db.Uuid
  tagId              String   @map("tag_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag              Tag              @relation(fields: [tagId], references: [id], onDelete: Cascade)
  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)

  @@unique([clientId, tagId])
  @@index([dietitianAccountId, tagId])
  @@map("client_tags")
}

model TimelineEvent {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String            @map("dietitian_account_id") @db.Uuid
  clientId           String            @map("client_id") @db.Uuid
  type               TimelineEventType
  targetType         String?           @map("target_type")
  targetId           String?           @map("target_id")
  actorUserId        String?           @map("actor_user_id") @db.Uuid
  occurredAt         DateTime          @default(now()) @map("occurred_at") @db.Timestamptz
  metadata           Json?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz

  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  actor            User?            @relation("TimelineActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([dietitianAccountId, clientId, occurredAt])
  @@index([clientId, occurredAt])
  @@map("timeline_events")
}

model AssessmentTemplate {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String         @map("dietitian_account_id") @db.Uuid
  name               String
  description        String?        @db.Text
  status             TemplateStatus @default(ACTIVE)
  version            Int            @default(1)
  schema             Json
  createdById        String?        @map("created_by_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)
  createdBy        User?            @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assessments      Assessment[]

  @@index([dietitianAccountId, status])
  @@map("assessment_templates")
}

model Assessment {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String           @map("dietitian_account_id") @db.Uuid
  clientId           String           @map("client_id") @db.Uuid
  templateId         String           @map("template_id") @db.Uuid
  templateVersion    Int              @map("template_version")
  status             AssessmentStatus @default(DRAFT)
  responses          Json?
  /// Frozen copy of template.schema at start — preserves historical response interpretation.
  schemaSnapshot     Json?            @map("schema_snapshot")
  startedAt          DateTime?        @map("started_at") @db.Timestamptz
  completedAt        DateTime?        @map("completed_at") @db.Timestamptz
  createdById        String?          @map("created_by_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  dietitianAccount DietitianAccount   @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)
  client           Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  template         AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy        User?              @relation("AssessmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([dietitianAccountId, clientId])
  @@index([clientId, status])
  @@map("assessments")
}

model ClientMeasurement {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String          @map("dietitian_account_id") @db.Uuid
  clientId           String          @map("client_id") @db.Uuid
  type               MeasurementType
  value              Decimal         @db.Decimal(12, 3)
  unit               String
  measuredAt         DateTime        @map("measured_at") @db.Timestamptz
  recordedById       String?         @map("recorded_by_id") @db.Uuid
  notes              String?         @db.Text
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz

  client           Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  recordedBy       User?            @relation("MeasurementRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)

  @@index([dietitianAccountId, clientId])
  @@index([clientId, measuredAt])
  @@map("client_measurements")
}

model Appointment {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String              @map("dietitian_account_id") @db.Uuid
  clientId           String              @map("client_id") @db.Uuid
  assignedUserId     String?             @map("assigned_user_id") @db.Uuid
  title              String
  category           AppointmentCategory @default(CONSULTATION)
  startAt            DateTime            @map("start_at") @db.Timestamptz
  endAt              DateTime            @map("end_at") @db.Timestamptz
  status             AppointmentStatus   @default(SCHEDULED)
  notes              String?             @db.Text
  proposedStartAt    DateTime?           @map("proposed_start_at") @db.Timestamptz
  proposedEndAt      DateTime?           @map("proposed_end_at") @db.Timestamptz
  proposedByUserId   String?             @map("proposed_by_user_id") @db.Uuid
  createdById        String?             @map("created_by_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  assignedUser     User?            @relation("AppointmentAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy        User?            @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  proposedBy       User?            @relation("AppointmentProposedBy", fields: [proposedByUserId], references: [id], onDelete: SetNull)

  @@index([dietitianAccountId, startAt])
  @@index([dietitianAccountId, clientId])
  @@index([clientId, startAt])
  @@index([assignedUserId])
  @@map("appointments")
}

enum FoodReferenceUnit {
  g
  ml
}

enum FoodOverrideStatus {
  ACTIVE
  INACTIVE
}

model FoodSource {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String        @unique
  name             String
  provider         String
  datasetVersion   String        @map("dataset_version")
  license          String        @db.Text
  attribution      String        @db.Text
  homepage         String?
  importedAt       DateTime      @map("imported_at") @db.Timestamptz
  metadata         Json?
  lastImportReport Json?         @map("last_import_report")
  status           CatalogStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  foods Food[]

  @@index([status])
  @@map("food_sources")
}

model Food {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  foodSourceId       String            @map("food_source_id") @db.Uuid
  sourceFoodId       String            @map("source_food_id")
  /// null = global catalog; set = practice-private custom food
  dietitianAccountId String?           @map("dietitian_account_id") @db.Uuid
  name               String
  nameNormalized     String            @map("name_normalized")
  category           String?
  servingDescription String?           @map("serving_description")
  referenceQuantity  Decimal           @map("reference_quantity") @db.Decimal(12, 4)
  referenceUnit      FoodReferenceUnit @map("reference_unit")
  energyKcal         Decimal?          @map("energy_kcal") @db.Decimal(12, 4)
  proteinG           Decimal?          @map("protein_g") @db.Decimal(12, 4)
  carbohydrateG      Decimal?          @map("carbohydrate_g") @db.Decimal(12, 4)
  fatG               Decimal?          @map("fat_g") @db.Decimal(12, 4)
  fiberG             Decimal?          @map("fiber_g") @db.Decimal(12, 4)
  sugarG             Decimal?          @map("sugar_g") @db.Decimal(12, 4)
  sodiumMg           Decimal?          @map("sodium_mg") @db.Decimal(12, 4)
  extraNutrients     Json?             @map("extra_nutrients")
  status             CatalogStatus     @default(ACTIVE)
  importedAt         DateTime          @map("imported_at") @db.Timestamptz
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  source            FoodSource         @relation(fields: [foodSourceId], references: [id], onDelete: Restrict)
  dietitianAccount  DietitianAccount?  @relation(fields: [dietitianAccountId], references: [id], onDelete: Cascade)
  overrides         FoodOverride[]
  recipeIngredients RecipeIngredient[]
  mealItems         MealItem[]
  foodLogs          FoodLog[]

  @@unique([foodSourceId, sourceFoodId])
  @@index([status, nameNormalized])
  @@index([category])
  @@index([foodSourceId, status])
  @@index([dietitianAccountId, status, nameNormalized])
  @@map("foods")
}

model FoodOverride {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String             @map("dietitian_account_id") @db.Uuid
  foodId             String             @map("food_id") @db.Uuid
  status             FoodOverrideStatus @default(ACTIVE)
  energyKcal         Decimal?           @map("energy_kcal") @db.Decimal(12, 4)
  proteinG           Decimal?           @map("protein_g") @db.Decimal(12, 4)
  carbohydrateG      Decimal?           @map("carbohydrate_g") @db.Decimal(12, 4)
  fatG               Decimal?           @map("fat_g") @db.Decimal(12, 4)
  fiberG             Decimal?           @map("fiber_g") @db.Decimal(12, 4)
  sugarG             Decimal?           @map("sugar_g") @db.Decimal(12, 4)
  sodiumMg           Decimal?           @map("sodium_mg") @db.Decimal(12, 4)
  createdById        String?            @map("created_by_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deactivatedAt      DateTime?          @map("deactivated_at") @db.Timestamptz

  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Cascade)
  food             Food             @relation(fields: [foodId], references: [id], onDelete: Restrict)
  createdBy        User?            @relation("FoodOverrideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([dietitianAccountId, foodId])
  @@index([dietitianAccountId, status])
  @@index([foodId])
  @@map("food_overrides")
}

enum RecipeStatus {
  ACTIVE
  ARCHIVED
}

enum MealPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MealPlanDayLabelMode {
  NUMBERED
  WEEKDAY
}

enum MealPlanVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum MealItemType {
  FOOD
  RECIPE
}

enum QuantityUnit {
  g
  kg
  oz
  lb
  ml
  l
  fl_oz
  serving
}

model Recipe {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String       @map("dietitian_account_id") @db.Uuid
  name               String
  description        String?      @db.Text
  instructions       String?      @db.Text
  servings           Decimal      @db.Decimal(12, 4)
  status             RecipeStatus @default(ACTIVE)
  createdById        String?      @map("created_by_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz

  dietitianAccount DietitianAccount   @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)
  createdBy        User?              @relation("RecipeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  ingredients      RecipeIngredient[]
  mealItems        MealItem[]

  @@index([dietitianAccountId, status, name])
  @@map("recipes")
}

model RecipeIngredient {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String       @map("dietitian_account_id") @db.Uuid
  recipeId           String       @map("recipe_id") @db.Uuid
  foodId             String       @map("food_id") @db.Uuid
  quantity           Decimal      @db.Decimal(12, 4)
  unit               QuantityUnit
  displayNote        String?      @map("display_note")
  sortOrder          Int          @default(0) @map("sort_order")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)
  recipe           Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food             Food             @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@index([dietitianAccountId, recipeId])
  @@index([recipeId, sortOrder])
  @@map("recipe_ingredients")
}

model MealPlan {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String              @map("dietitian_account_id") @db.Uuid
  clientId           String              @map("client_id") @db.Uuid
  name               String
  description        String?             @db.Text
  status             MealPlanStatus      @default(DRAFT)
  dayLabelMode       MealPlanDayLabelMode @default(NUMBERED) @map("day_label_mode")
  createdById        String?             @map("created_by_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt         DateTime?           @map("archived_at") @db.Timestamptz

  dietitianAccount DietitianAccount  @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy        User?             @relation("MealPlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  versions         MealPlanVersion[]

  @@index([dietitianAccountId, clientId, status])
  @@index([dietitianAccountId, status])
  @@map("meal_plans")
}

model MealPlanVersion {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String                @map("dietitian_account_id") @db.Uuid
  mealPlanId         String                @map("meal_plan_id") @db.Uuid
  versionNumber      Int                   @map("version_number")
  status             MealPlanVersionStatus @default(DRAFT)
  snapshot           Json?
  createdById        String?               @map("created_by_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz
  publishedAt        DateTime?             @map("published_at") @db.Timestamptz
  archivedAt         DateTime?             @map("archived_at") @db.Timestamptz

  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)
  mealPlan         MealPlan         @relation(fields: [mealPlanId], references: [id], onDelete: Restrict)
  createdBy        User?            @relation("MealPlanVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  days             MealPlanDay[]

  @@unique([mealPlanId, versionNumber])
  @@index([dietitianAccountId, mealPlanId, status])
  @@map("meal_plan_versions")
}

model MealPlanDay {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String   @map("dietitian_account_id") @db.Uuid
  mealPlanVersionId  String   @map("meal_plan_version_id") @db.Uuid
  dayNumber          Int      @map("day_number")
  weekday            String?
  title              String?
  notes              String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)
  version          MealPlanVersion  @relation(fields: [mealPlanVersionId], references: [id], onDelete: Cascade)
  meals            Meal[]

  @@unique([mealPlanVersionId, dayNumber])
  @@index([dietitianAccountId, mealPlanVersionId])
  @@map("meal_plan_days")
}

model Meal {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String   @map("dietitian_account_id") @db.Uuid
  mealPlanDayId      String   @map("meal_plan_day_id") @db.Uuid
  name               String
  sortOrder          Int      @default(0) @map("sort_order")
  notes              String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)
  day              MealPlanDay      @relation(fields: [mealPlanDayId], references: [id], onDelete: Cascade)
  items            MealItem[]

  @@index([dietitianAccountId, mealPlanDayId, sortOrder])
  @@map("meals")
}

model MealItem {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String       @map("dietitian_account_id") @db.Uuid
  mealId             String       @map("meal_id") @db.Uuid
  itemType           MealItemType @map("item_type")
  foodId             String?      @map("food_id") @db.Uuid
  recipeId           String?      @map("recipe_id") @db.Uuid
  quantity           Decimal      @db.Decimal(12, 4)
  unit               QuantityUnit
  sortOrder          Int          @default(0) @map("sort_order")
  notes              String?
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)
  meal             Meal             @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food             Food?            @relation(fields: [foodId], references: [id], onDelete: Restrict)
  recipe           Recipe?          @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@index([dietitianAccountId, mealId, sortOrder])
  @@index([foodId])
  @@index([recipeId])
  @@map("meal_items")
}

enum FoodLogSourceType {
  MANUAL
  PLANNED_MEAL
}

enum HabitFrequency {
  DAILY
}

model FoodLog {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId       String            @map("dietitian_account_id") @db.Uuid
  clientId                 String            @map("client_id") @db.Uuid
  foodId                   String?           @map("food_id") @db.Uuid
  displayName              String?           @map("display_name")
  sourceType               FoodLogSourceType @default(MANUAL) @map("source_type")
  sourceMealId             String?           @map("source_meal_id") @db.Uuid
  sourceMealPlanVersionId  String?           @map("source_meal_plan_version_id") @db.Uuid
  servingsLogged           Decimal?          @map("servings_logged") @db.Decimal(12, 4)
  servingDescription       String?           @map("serving_description")
  clientRequestId          String?           @map("client_request_id") @db.Uuid
  quantity                 Decimal           @db.Decimal(12, 4)
  unit                     QuantityUnit
  consumedAt               DateTime          @map("consumed_at") @db.Timestamptz
  trackingDate             DateTime          @map("tracking_date") @db.Date
