generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PlatformRole {
  SUPER_ADMIN
  ADMIN
}

enum InvitationPurpose {
  DIETITIAN_ACTIVATION
  STAFF_INVITE
  CLIENT_INVITE
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
}

model User {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String
  emailNormalized String        @unique @map("email_normalized")
  passwordHash    String        @map("password_hash")
  status          UserStatus    @default(PENDING)
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz
  platformRole    PlatformRole? @map("platform_role")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  suspendedAt     DateTime?     @map("suspended_at") @db.Timestamptz
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz
  firstName       String?       @map("first_name")
  lastName        String?       @map("last_name")

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  invitationsCreated      InvitationToken[]        @relation("InvitationCreatedBy")
  invitationsUsed         InvitationToken[]        @relation("InvitationUsedBy")
  consents                Consent[]
  featureOverridesCreated FeatureOverride[]        @relation("FeatureOverrideCreatedBy")
  auditLogs               AuditLog[]               @relation("AuditLogActor")
  dietitianAccount        DietitianAccount?
  clientAccounts          ClientAccount[]
  clientsCreated          Client[]                 @relation("ClientCreatedBy")
  clientAssignments       ClientAssignment[]       @relation("ClientAssignmentUser")
  assignmentsMade         ClientAssignment[]       @relation("AssignmentAssignedBy")
  goalsCreated            ClientGoal[]             @relation("GoalCreatedBy")
  measurementsRecorded    ClientMeasurement[]      @relation("MeasurementRecordedBy")
  timelineEvents          TimelineEvent[]          @relation("TimelineActor")
  assessmentsCreated      Assessment[]             @relation("AssessmentCreatedBy")
  templatesCreated        AssessmentTemplate[]     @relation("TemplateCreatedBy")
  appointmentsCreated     Appointment[]            @relation("AppointmentCreatedBy")
  appointmentsAssigned    Appointment[]            @relation("AppointmentAssignedUser")
  appointmentsProposed    Appointment[]            @relation("AppointmentProposedBy")
  foodOverridesCreated    FoodOverride[]           @relation("FoodOverrideCreatedBy")
  recipesCreated          Recipe[]                 @relation("RecipeCreatedBy")
  mealPlansCreated        MealPlan[]               @relation("MealPlanCreatedBy")
  mealPlanVersionsCreated MealPlanVersion[]        @relation("MealPlanVersionCreatedBy")
  messagesSent            Message[]
  documentsUploaded       Document[]               @relation("DocumentUploadedBy")
  documentsShared         Document[]               @relation("DocumentSharedBy")
  notifications           Notification[]
  conversationReadStates  ConversationReadState[]
  invoicesCreated         Invoice[]                @relation("InvoiceCreatedBy")
  tasksCreated            Task[]                   @relation("TaskCreatedBy")
  tasksAssigned           Task[]                   @relation("TaskAssignedUser")
  aiRequests              AiRequest[]
  automationRulesCreated  AutomationRule[]         @relation("AutomationRuleCreatedBy")
  automationRulesUpdated  AutomationRule[]         @relation("AutomationRuleUpdatedBy")

  @@map("users")
}

model Session {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt     DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent") @db.Text
  activeClientId String?   @map("active_client_id") @db.Uuid

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeClient Client? @relation(fields: [activeClientId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeClientId])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model InvitationToken {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash          String            @unique @map("token_hash")
  purpose            InvitationPurpose
  emailNormalized    String?           @map("email_normalized")
  createdById        String?           @map("created_by_id") @db.Uuid
  usedById           String?           @map("used_by_id") @db.Uuid
  clientId           String?           @map("client_id") @db.Uuid
  dietitianAccountId String?           @map("dietitian_account_id") @db.Uuid
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz
  usedAt             DateTime?         @map("used_at") @db.Timestamptz
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz

  createdBy        User?             @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy           User?             @relation("InvitationUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  dietitianAccount DietitianAccount? @relation(fields: [dietitianAccountId], references: [id], onDelete: SetNull)

  @@index([purpose])
  @@index([clientId])
  @@index([dietitianAccountId])
  @@map("invitation_tokens")
}

model Consent {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  type          ConsentType
  policyVersion String      @map("policy_version")
  acceptedAt    DateTime    @map("accepted_at") @db.Timestamptz
  ipAddress     String?     @map("ip_address")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("consents")
}

enum WeightUnit {
  kg
  lb
}

enum HeightUnit {
  cm
  in
}

enum DateFormat {
  YYYY_MM_DD
  DD_MM_YYYY
  MM_DD_YYYY
}

enum DietitianAccountStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model DietitianAccount {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                 @unique @map("user_id") @db.Uuid
  displayName       String                 @map("display_name")
  slug              String                 @unique
  status            DietitianAccountStatus @default(ACTIVE)
  phone             String?
  professionalTitle String?                @map("professional_title")
  specialization    String?
  country           String?
  photoStorageKey   String?                @map("photo_storage_key")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt        DateTime?              @map("archived_at") @db.Timestamptz
  suspendedAt       DateTime?              @map("suspended_at") @db.Timestamptz

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  settings               DietitianSettings?
  subscription           Subscription?
  featureOverrides       FeatureOverride[]
  auditLogs              AuditLog[]
  clients                Client[]
  clientAccounts         ClientAccount[]
  clientAssignments      ClientAssignment[]
  clientProfiles         ClientProfile[]
  clientGoals            ClientGoal[]
  clientTags             ClientTag[]
  clientMeasurements     ClientMeasurement[]
  tags                   Tag[]
  timelineEvents         TimelineEvent[]
  assessmentTemplates    AssessmentTemplate[]
  assessments            Assessment[]
  appointments           Appointment[]
  invitationTokens       InvitationToken[]
  foodOverrides          FoodOverride[]
  foods                  Food[]
  recipes                Recipe[]
  recipeIngredients      RecipeIngredient[]
  mealPlans              MealPlan[]
  mealPlanVersions       MealPlanVersion[]
  mealPlanDays           MealPlanDay[]
  meals                  Meal[]
  mealItems              MealItem[]
  foodLogs               FoodLog[]
  waterLogs              WaterLog[]
  exerciseLogs           ExerciseLog[]
  sleepLogs              SleepLog[]
  habitLogs              HabitLog[]
  habitDefinitions       HabitDefinition[]
  clientHabitAssignments ClientHabitAssignment[]
  conversations          Conversation[]
  messages               Message[]
  conversationReadStates ConversationReadState[]
  documents              Document[]
  notifications          Notification[]
  invoices               Invoice[]
  invoiceItems           InvoiceItem[]
  invoiceSequence        InvoiceSequence?
  tasks                  Task[]
  aiRequests             AiRequest[]
  aiUsage                AiUsage[]
  automationRules        AutomationRule[]
  automationRuns         AutomationRun[]
  automationUsage        AutomationUsage[]

  @@index([status])
  @@map("dietitian_accounts")
}

model DietitianSettings {
  id                        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId        String     @unique @map("dietitian_account_id") @db.Uuid
  timezone                  String
  locale                    String
  currency                  String
  weightUnit                WeightUnit @map("weight_unit")
  heightUnit                HeightUnit @map("height_unit")
  dateFormat                DateFormat @map("date_format")
  practiceName              String?    @map("practice_name")
  logoStorageKey            String?    @map("logo_storage_key")
  contactEmail              String?    @map("contact_email")
  contactPhone              String?    @map("contact_phone")
  addressLine1              String?    @map("address_line1")
  addressLine2              String?    @map("address_line2")
  city                      String?
  region                    String?
  postalCode                String?    @map("postal_code")
  country                   String?
  defaultAppointmentMinutes Int        @default(60) @map("default_appointment_minutes")
  reminderEmailEnabled      Boolean    @default(true) @map("reminder_email_enabled")
  reminderHoursBefore       Int        @default(24) @map("reminder_hours_before")
  invoiceDefaultDueDays     Int        @default(14) @map("invoice_default_due_days")
  invoiceDefaultTaxPercent  Decimal    @default(0) @map("invoice_default_tax_percent") @db.Decimal(8, 4)
  invoiceFooter             String?    @map("invoice_footer") @db.Text
  emailFromName             String?    @map("email_from_name")
  emailReplyTo              String?    @map("email_reply_to")
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Cascade)

  @@map("dietitian_settings")
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FeatureValueType {
  BOOLEAN
  LIMIT
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum AuditResult {
  SUCCESS
  FAILURE
}

model Plan {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String        @unique
  description String?       @db.Text
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  planFeatures  PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

model Feature {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  name        String
  description String?          @db.Text
  valueType   FeatureValueType @map("value_type")
  status      CatalogStatus    @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  planFeatures PlanFeature[]
  overrides    FeatureOverride[]

  @@map("features")
}

model PlanFeature {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId        String   @map("plan_id") @db.Uuid
  featureId     String   @map("feature_id") @db.Uuid
  enabled       Boolean  @default(false)
  limitValue    Int?     @map("limit_value")
  configuration Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@unique([planId, featureId])
  @@index([featureId])
  @@map("plan_features")
}

model Subscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String             @unique @map("dietitian_account_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(PENDING)
  startedAt          DateTime?          @map("started_at") @db.Timestamptz
  currentPeriodStart DateTime?          @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz
  trialStartsAt      DateTime?          @map("trial_starts_at") @db.Timestamptz
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz
  billingCycle       BillingCycle?      @map("billing_cycle")
  provider           String?
  externalId         String?            @map("external_id")
  paymentStatus      String?            @map("payment_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Restrict)
  plan             Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model FeatureOverride {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietitianAccountId String   @map("dietitian_account_id") @db.Uuid
  featureId          String   @map("feature_id") @db.Uuid
  enabled            Boolean?
  limitValue         Int?     @map("limit_value")
  configuration      Json?
  reason             String   @db.Text
  createdById        String?  @map("created_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dietitianAccount DietitianAccount @relation(fields: [dietitianAccountId], references: [id], onDelete: Cascade)
  feature          Feature          @relation(fields: [featureId], references: [id], onDelete: Restrict)
  createdBy        User?            @relation("FeatureOverrideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([dietitianAccountId, featureId])
  @@index([featureId])
  @@index([dietitianAccountId])
  @@map("feature_overrides")
}

model AuditLog {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId        String?     @map("actor_user_id") @db.Uuid
  dietitianAccountId String?     @map("dietitian_account_id") @db.Uuid
  action             String
  targetType         String?     @map("target_type")
  targetId           String?     @map("target_id")
  requestId          String?     @map("request_id")
  result             AuditResult
  metadata           Json?
  ip                 String?
  userAgent          String?     @map("user_agent") @db.Text
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz

  actor            User?             @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  dietitianAccount DietitianAccount? @relation(fields: [dietitianAccountId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([dietitianAccountId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

