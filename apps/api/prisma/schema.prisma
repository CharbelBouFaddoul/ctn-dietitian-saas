  contactEmail              String?          @map("contact_email")
  contactPhone              String?          @map("contact_phone")
  contactAddress            String?          @map("contact_address") @db.Text
  contactHours              String?          @map("contact_hours")
  registrationEnabled       Boolean          @default(false) @map("registration_enabled")
  emailNotificationsEnabled Boolean          @default(false) @map("email_notifications_enabled")
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_settings")
}
