# Copy to .env for local development.
# Never commit secrets. Use separate values for development, staging, and production.

# --- Runtime ---
# development | test | production
NODE_ENV=development
LOG_LEVEL=info

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- API ---
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# OpenAPI/Swagger at /api/docs.
# Development: enabled unless set to false.
# Production: disabled unless explicitly set to true.
SWAGGER_ENABLED=true

# Public web origin used in emailed verification/reset links.
APP_URL=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=nutrition
POSTGRES_DB=nutrition
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nutrition:nutrition@localhost:5432/nutrition?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Persistent file storage ---
# Coolify/production mounts a volume at /data/storage.
# Local development uses ./storage (gitignored).
FILE_STORAGE_PATH=./storage

# --- Auth (Phase 2) ---
# HMAC pepper for session/verification/reset/invitation tokens at rest.
# Generate a long random string. Never commit production secrets.
AUTH_TOKEN_SECRET=change-me-to-a-long-random-secret-value
SESSION_TTL_SECONDS=604800
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
INVITATION_TTL_SECONDS=604800
PASSWORD_MIN_LENGTH=10
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10
MAX_DOCUMENT_BYTES=20971520
# Optional override. Default: true in production, false otherwise.
# COOKIE_SECURE=false

# --- AI (Phase 11) ---
# mock provider works without an API key for development and tests.
AI_ENABLED=true
AI_PROVIDER=mock
# AI_PROVIDER=openai
# AI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=30000
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=2000

# --- Email (Phase 13) ---
# console (default) logs to API stdout. smtp sends via transactional provider.
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=noreply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# --- Rate limiting (Phase 13) ---
MESSAGING_THROTTLE_TTL_MS=60000
MESSAGING_THROTTLE_LIMIT=30
UPLOAD_THROTTLE_TTL_MS=60000
UPLOAD_THROTTLE_LIMIT=20
AI_THROTTLE_TTL_MS=60000
AI_THROTTLE_LIMIT=20

# --- Error tracking (Phase 13) ---
# When true, 5xx errors emit structured error logs for external monitoring drains.
ERROR_TRACKING_ENABLED=false
