{
  "name": "nutrition-saas",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo typecheck",
    "prisma:generate": "pnpm --filter @nutrition-saas/api prisma:generate",
    "prisma:migrate": "pnpm --filter @nutrition-saas/api prisma:migrate",
    "prisma:migrate:dev": "pnpm --filter @nutrition-saas/api prisma:migrate:dev",
    "food:import": "pnpm --filter @nutrition-saas/api food:import",
    "test": "pnpm --filter @nutrition-saas/api test"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
